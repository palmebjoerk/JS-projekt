    <header class="site-header">
        <div class="header-top">
            <div class="header-logo-row">
                <a href="/"><img class="logo" src="/stylesheets/Images/Freaky-Fashion-Logo.png" alt="Logotyp"></a>
            </div>

            <div class="header-search-icons-row">
                <div class="search-row">
                    <input type="text" class="search-input" id="search-input" placeholder="Sök produkt" autocomplete="off">
                    <ul class="search-dropdown" id="search-dropdown"></ul>
                </div>

                <div class="header-right icons">
                    <a href="/favorites" aria-label="Favoriter" class="icon-btn">❤</a>
                    <a href="/basket" aria-label="Kundvagn" class="icon-btn">🛒</a>
                    <% if (typeof user !== 'undefined' && user) { %>
                    <a href="/logout" aria-label="Logga ut" class="icon-btn" title="Inloggad som <%= user %>">👤</a>
                    <% } else { %>
                    <a href="/login" aria-label="Logga in" class="icon-btn">👤</a>
                    <% } %>
                </div>
            </div>
        </div>

        <nav class="nav-bar">
            <ul>
                <li><a href="/news">Nyheter</a></li>
                <li><a href="/categories/klader">Kläder</a></li>
                <li><a href="/categories/Kepsar">Kepor</a></li>
            </ul>
        </nav>
    </header>
