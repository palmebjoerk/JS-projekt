<section class="spots-section">
    <% spots.forEach(function(spot) { %>
        <a href="/categories/<%= spot.keyword %>" class="spot-item">
            <img src="<%= spot.image %>" alt="<%= spot.name %>">
            <div class="spot-overlay">
                <h3><%= spot.name %></h3>
            </div>
        </a>
    <% }); %>
</section>
