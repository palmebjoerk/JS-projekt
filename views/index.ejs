<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projekt Arbete</title>
</head>
</head>
<body>
    <%- include("essentials/header.ejs"); %>
<main>
    <section class="hero">
        <div class="hero-image">
            <img src="Images/toa-heftiba-ZoAhudO-BQM-unsplash.jpg" alt="Hero Image">
        </div>

        <div class="hero-text-below">
            <h1>Lorem Ipsum dolor</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec vel sapien eget nunc efficitur bibendum.</p>
        </div>
    </section>

    <section class="hero-spots">
        <article class="spot-card">
            <div class="spot-card-content">
                <h3>Material:</h3>
                <p>100% bomull</p>
            </div>
        </article>

        <article class="spot-card">
            <div class="spot-card-content">
                <h3>Material:</h3>
                <p>100% bomull</p>
            </div>
        </article>

        <article class="spot-card">
            <div class="spot-card-content">
                <h3>Material:</h3>
                <p>100% bomull</p>
            </div>
        </article>
    </section>

    <section class="product-grid">
       <% for (let i = 0; i < 8; i++) { %>
  <article class="product-card">
    <a
      class="product-link"
      href="Produkt-details.html"
      aria-label="Visa produkt: Svart tröja"
    >
      <img src="Images/Svart T-shirt.jpg" alt="Svart tröja" />
      <div class="product-meta">
        <div class="product-info">
          <span class="product-name">Svart tröja</span>
          <span class="product-brand">Levis</span>
        </div>
        <span class="product-price">199kr</span>
      </div>
    </a>
  </article>
<% } %>

        
    </section>

    <section class="footer-panel">
        <div class="benefit-row">
            <div class="benefit-item">
                <span class="benefit-icon">🌍</span>
                <p>Gratis frakt och returer</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">🔒</span>
                <p>Säkra betalningar</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">✈️</span>
                <p>Expressfrakt</p>
            </div>

            <div class="benefit-item">
                <span class="benefit-icon">😊</span>
                <p>Nyheter varje dag</p>
            </div>
        </div>

        <div class="footer-menu">
            <div class="menu-block">
                <h3>Shopping</h3>
                <ul>
                    <li><a href="#">Vinterjackor</a></li>
                    <li><a href="#">Pufferjackor</a></li>
                    <li><a href="#">Kappa</a></li>
                    <li><a href="#">Trenchcoats</a></li>
                </ul>
            </div>

            <div class="menu-block">
                <h3>Mina Sidor</h3>
                <ul>
                    <li><a href="#">Mina Ordrar</a></li>
                    <li><a href="#">Mitt Konto</a></li>
                </ul>
            </div>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-copy">
        <p>&copy 2026 Freaky Fashion</p>
    </div>
</footer>

</body>
</html>