<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projekt Arbete</title>
</head>
<body>
    <%- include("partials/header.ejs"); %>
    <main>
        <%- include("partials/hero.ejs"); %>


        <%- include("partials/spots.ejs"); %>

        <section class="product-grid">
            <% if (clothes && clothes.length) { %>
                <% clothes.forEach(function(item) { %>
                    <article class="product-card">
                        <a href="#" class="product-link">
                            <div class="product-img-wrap">
                                <img src="<%= item.image %>" alt="<%= item.name %>">
                                <button class="favorite-btn" aria-label="Spara till favoriter">❤</button>
                            </div>
                            <div class="product-meta">
                                <div class="product-info">
                                    <span class="product-name"><%= item.name %></span>
                                    <p class="product-subtext"><%= item.brand %> <%= item.model %> | <%= item.color %></p>
                                </div>
                                <span class="product-price">
                                    <% if (item.price > 0) { %>
                                        <%= item.price %> kr
                                    <% } else { %>
                                        Kontakta oss
                                    <% } %>
                                </span>
                            </div>
                        </a>
                    </article>
                <% }); %>
            <% } else { %>
                <article class="product-card empty-state">
                    <p>Inga produkter att visa än.</p>
                </article>
            <% } %>
        </section>
    </main>

    <section class="footer-panel">
        <div class="benefit-row">
            <div class="benefit-item">
                <span class="benefit-icon">🌍</span>
                <p>Gratis frakt och returer</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">🔒</span>
                <p>Säkra betalningar</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">✈️</span>
                <p>Expressfrakt</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">😊</span>
                <p>Nyheter varje dag</p>
            </div>
        </div>

        <div class="footer-menu">
            <div class="menu-block">
                <h3>Shopping</h3>
                <ul>
                    <li><a href="#">Vinterjackor</a></li>
                    <li><a href="#">Pufferjackor</a></li>
                    <li><a href="#">Kappa</a></li>
                    <li><a href="#">Trenchcoats</a></li>
                </ul>
            </div>
            <div class="menu-block">
                <h3>Mina Sidor</h3>
                <ul>
                    <li><a href="#">Mina Ordrar</a></li>
                    <li><a href="#">Mitt Konto</a></li>
                </ul>
            </div>
            <div class="menu-block">
                <h3>Kundtjänst</h3>
                <ul>
                    <li><a href="#">Kontakta oss</a></li>
                    <li><a href="#">Vanliga frågor</a></li>
                    <li><a href="#">Returer</a></li>
                </ul>
            </div>
        </div>
    </section>

    <%- include("partials/footer.ejs"); %>
</body>
</html>
