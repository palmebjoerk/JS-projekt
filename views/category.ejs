<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="/stylesheets/products.css">
    <link rel="stylesheet" href="/stylesheets/favorites.css">
</head>
<body>
    <%- include("partials/header.ejs"); %>
    <main>
        <h2 style="padding: 16px 0 0 8px;"><%= title %></h2>
        <section class="product-grid">
            <% if (clothes && clothes.length) { %>
                <% clothes.forEach(function(item) { %>
                    <article class="product-card">
                        <a href="#" class="product-link">
                            <div class="product-img-wrap">
                                <img src="<%= item.image %>" alt="<%= item.name %>">
                                <button class="favorite-btn"
                                    data-id="<%= item.id || item.image %>"
                                    data-name="<%= item.name %>"
                                    data-brand="<%= item.brand || '' %>"
                                    data-model="<%= item.model || '' %>"
                                    data-color="<%= item.color || '' %>"
                                    data-price="<%= item.price %>"
                                    data-image="<%= item.image %>"
                                    aria-label="Spara till favoriter">❤</button>
                            </div>
                            <div class="product-meta">
                                <div class="product-info">
                                    <span class="product-name"><%= item.name %></span>
                                    <p class="product-subtext"><%= item.brand %> <%= item.model %> | <%= item.color %></p>
                                </div>
                                <span class="product-price">
                                    <% if (item.price > 0) { %>
                                        <%= item.price %> kr
                                    <% } else { %>
                                        Kontakta oss
                                    <% } %>
                                </span>
                            </div>
                        </a>
                    </article>
                <% }); %>
            <% } else { %>
                <article class="product-card empty-state">
                    <p>Inga produkter att visa.</p>
                </article>
            <% } %>
        </section>
    </main>
    <%- include("partials/footer.ejs"); %>
    <script src="/javascripts/favorites.js"></script>
</body>
</html>
