<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <link rel="stylesheet" href="admin.css">
</head>
<body>

    <header class="admin-header">
        <h1>Administration</h1>
    </header>
    
    <main>
        <div class="container">
            
            <aside class="produkter-info" aria-label="Produkter navigation">
                <h2>Produkter</h2>
            </aside>

            <section class="admin-content" aria-label="Ny produkt formulär">
                <h2>Ny produkt</h2>

                <form class="product-form" action="#" method="post">
                    <!-- Produktnamn -->
                    <label for="product-name">Namn</label>
                    <input id="product-name" name="name" type="text">

                    <label for="product-description">Beskrivning</label>
                    <textarea id="product-description" name="description" rows="5"></textarea>

                    <label for="product-image">Bild</label>
                    <input id="product-image" name="image" type="file" accept="image/*">

                    <label for="product-sku">SKU</label>
                    <input id="product-sku" name="sku" type="text">

                    <label for="product-price">Pris</label>
                    <input id="product-price" name="price" type="number" min="0" step="1" inputmode="numeric">

                    <button type="button">Lägg till</button>
                </form>
            </section>
        </div>
    </main>

</body>
</html>