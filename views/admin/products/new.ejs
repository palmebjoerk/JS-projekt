<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administration - Ny produkt</title>
    <link rel="stylesheet" href="/stylesheets/admin_products.css">
</head>
<body>

  <div class="admin-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <h2>Administration</h2>

      <nav>
        <a href="/admin/products" class="active">Produkter</a>
        <a href="#">Kategorier</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="content">

      <div class="top-bar">
        <h1>Ny produkt</h1>
      </div>

      <div class="form-container">
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="form-message"><%= message %></div>
        <% } %>
        <form class="product-form" action="/admin/products/new" method="post" enctype="multipart/form-data">
          <label for="product-sku">SKU</label>
          <input id="product-sku" name="sku" type="text" required>

          <label for="product-brand">Märke</label>
          <input id="product-brand" name="brand" type="text" required>

          <label for="product-model">Modell</label>
          <input id="product-model" name="model" type="text" required>

          <label for="product-color">Färg</label>
          <input id="product-color" name="color" type="text" required>

          <label for="product-description">Beskrivning</label>
          <textarea id="product-description" name="description" rows="5" required></textarea>

          <label for="product-price">Pris</label>
          <input id="product-price" name="price" type="number" min="0" step="1" inputmode="numeric" required>

          <label for="product-image">Bild</label>
          <input id="product-image" name="image" type="file" accept="image/*">

          <button type="submit">Lägg till</button>
        </form>
      </div>

    </main>
  </div>

</body>
</html>