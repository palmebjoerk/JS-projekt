<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nyheter – Freaky Fashion</title>
    <link rel="stylesheet" href="/stylesheets/news.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
</head>
<body>
  <%- include("partials/header.ejs"); %>

  <main>
    <section class="news-section">

      <h2 class="section-title">Nyheter</h2>

      <div class="products-grid">

        <% newsProducts.forEach(function(product) { %>
        <article class="product-card">
          <a href="/products/<%= (product.color + '-' + product.model).toLowerCase().replace(/ /g, '-').replace(/å/g, 'a') %>" class="product-link">
            <div class="product-image">
              <% if (product.image) { %>
                <img src="<%= product.image %>" alt="<%= product.color %> <%= product.model %>">
              <% } %>
              <button class="favorite-btn"
                data-id="<%= product.id %>"
                data-name="<%= product.color %> <%= product.model %>"
                data-brand="<%= product.brand %>"
                data-model="<%= product.model %>"
                data-color="<%= product.color %>"
                data-price="<%= product.price %>"
                data-image="<%= product.image %>"
                aria-label="Spara till favoriter">❤</button>
            </div>
          </a>

          <div class="product-info">
            <div>
              <p class="product-name"><%= product.color %> <%= product.model %></p>
              <p class="product-brand"><%= product.brand %></p>
            </div>
            <p class="product-price"><%= product.price %> kr</p>
          </div>
        </article>
        <% }); %>

      </div>

    </section>
  </main>

  <%- include("partials/footer.ejs"); %>

  <script src="/javascripts/basket.js"></script>
  <script src="/javascripts/favorites.js"></script>
</body>
</html>
