<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Varukorgen</title>
    <link rel="stylesheet" href="/stylesheets/basket.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
</head>
<body>
  <%- include("partials/header.ejs"); %>
  <main>
    <section class="cart-section">

  <h1 class="cart-title">Varukorgen</h1>

  <div class="cart-table-wrapper">
    <table class="cart-table">
      <thead>
        <tr>
          <th>Produkt</th>
          <th>Pris</th>
          <th>Totalt</th>
          <th>Antal</th>
        </tr>
      </thead>
      <tbody id="cart-tbody">
      </tbody>
    </table>
  </div>

  <div class="checkout-wrapper">
    <p class="cart-total-label">Totalt: <strong id="cart-total">0 kr</strong></p>
    <button class="checkout-btn">Till kassan</button>
  </div>

</section>
  </main>
<%- include("partials/footer.ejs"); %>
<script src="/javascripts/basket.js"></script>
</body>
</html>
