<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logga in - Freaky Fashion</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="/stylesheets/login.css">
</head>
<body>
    <%- include("partials/header.ejs") %>
    <main>
        <div class="auth-container">
            <div class="auth-card">
                <h1>Logga in</h1>
                <% if (error) { %>
                <div class="auth-error"><%= error %></div>
                <% } %>
                <form method="POST" action="/login">
                    <div class="auth-field">
                        <label for="email">E-post</label>
                        <input type="email" id="email" name="email" placeholder="din@epost.se" required>
                    </div>
                    <div class="auth-field">
                        <label for="password">Lösenord</label>
                        <input type="password" id="password" name="password" placeholder="Lösenord" required>
                    </div>
                    <button type="submit" class="auth-btn">Logga in</button>
                </form>
                <div class="auth-link">
                    Har du inget konto? <a href="/register">Skapa konto</a>
                </div>
            </div>
        </div>
    </main>
    <%- include("partials/footer.ejs") %>
</body>
</html>
