<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.model %></title>
    <link rel="stylesheet" href="/stylesheets/details.css">
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
</head>
<body>
    <%- include("../partials/header.ejs"); %>

    <main class="detail-main">

        <article class="product-detail">
            <div class="product-image-wrap">
                <img class="product-image"
                    src="<%= product.image_url ? (product.image_url.startsWith('/') ? product.image_url : '/stylesheets/Images/' + product.image_url) : '/stylesheets/Images/placeholder.jpg' %>"
                    alt="<%= product.color %> <%= product.model %>">
            </div>

            <div class="product-info">
                <h1><%= product.color %> <%= product.model %></h1>
                <p class="brand"><%= product.brand %></p>
                <p class="description"><%= product.description %></p>
                <p class="price"><%= product.price %> SEK</p>
                <div class="product-actions">
                    <button type="button" class="add-to-cart"
                        data-id="<%= product.id %>"
                        data-name="<%= product.color %> <%= product.model %>"
                        data-price="<%= product.price %>"
                        data-image="<%= product.image_url ? (product.image_url.startsWith('/') ? product.image_url : '/stylesheets/Images/' + product.image_url) : '' %>">
                        Lägg i varukorg
                    </button>
                    <button type="button" class="detail-fav-btn favorite-btn"
                        data-id="<%= product.id %>"
                        data-name="<%= product.color %> <%= product.model %>"
                        data-brand="<%= product.brand || '' %>"
                        data-model="<%= product.model || '' %>"
                        data-color="<%= product.color || '' %>"
                        data-price="<%= product.price %>"
                        data-image="<%= product.image_url ? (product.image_url.startsWith('/') ? product.image_url : '/stylesheets/Images/' + product.image_url) : '' %>"
                        aria-label="Spara till favoriter">❤</button>
                </div>
            </div>
        </article>

        <% if (similar && similar.length) { %>
        <section class="similar-section">
            <h2>Liknande produkter</h2>
            <div class="carousel-container">
                <button class="carousel-btn prev" aria-label="Föregående">&#8249;</button>
                <div class="carousel-viewport">
                    <div class="similar-grid">
                        <% similar.forEach(function(p) { %>
                            <% const slug = (p.color + '-' + p.model).toLowerCase().replace(/ /g, '-').replace(/å/g, 'a'); %>
                            <a href="/products/<%= slug %>" class="similar-card">
                                <img
                                    src="<%= p.image_url ? (p.image_url.startsWith('/') ? p.image_url : '/stylesheets/Images/' + p.image_url) : '/stylesheets/Images/placeholder.jpg' %>"
                                    alt="<%= p.color %> <%= p.model %>">
                                <p class="similar-name"><%= p.color %> <%= p.model %></p>
                                <p class="similar-brand"><%= p.brand %></p>
                                <p class="similar-price"><%= p.price %> SEK</p>
                            </a>
                        <% }); %>
                    </div>
                </div>
                <button class="carousel-btn next" aria-label="Nästa">&#8250;</button>
            </div>
        </section>
        <% } %>

    </main>

    <section class="footer-panel">
        <div class="benefit-row">
            <div class="benefit-item">
                <span class="benefit-icon">🌍</span>
                <p>Gratis frakt och returer</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">✈️</span>
                <p>Expressfrakt</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">🔒</span>
                <p>Säkra betalningar</p>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">😊</span>
                <p>Nyheter varje dag</p>
            </div>
        </div>

        <div class="footer-menu">
            <div class="menu-block">
                <h3>Shopping</h3>
                <ul>
                    <li><a href="#">Vinterjackor</a></li>
                    <li><a href="#">Pufferjackor</a></li>
                    <li><a href="#">Kappa</a></li>
                    <li><a href="#">Trenchcoats</a></li>
                </ul>
            </div>
            <div class="menu-block">
                <h3>Mina Sidor</h3>
                <ul>
                    <li><a href="#">Mina Ordrar</a></li>
                    <li><a href="#">Mitt Konto</a></li>
                </ul>
            </div>
            <div class="menu-block">
                <h3>Kundtjänst</h3>
                <ul>
                    <li><a href="#">Returpolicy</a></li>
                    <li><a href="#">Integritetspolicy</a></li>
                </ul>
            </div>
        </div>

        <p class="footer-panel-brand">&#169; Freaky Fashion</p>
    </section>
    <script src="/javascripts/basket.js"></script>
    <script src="/javascripts/favorites.js"></script>
    <script>
        (function () {
            const viewport = document.querySelector('.carousel-viewport');
            const grid = document.querySelector('.similar-grid');
            const prevBtn = document.querySelector('.carousel-btn.prev');
            const nextBtn = document.querySelector('.carousel-btn.next');
            if (!viewport || !grid || !prevBtn || !nextBtn) return;

            let index = 0;

            function isActive() {
                return window.innerWidth >= 640;
            }

            function getVisible() {
                return window.innerWidth >= 1024 ? 3 : 2;
            }

            function getCards() {
                return Array.from(grid.querySelectorAll('.similar-card'));
            }

            function getGap() {
                return parseInt(getComputedStyle(grid).gap) || 0;
            }

            function update() {
                if (!isActive()) {
                    grid.style.transform = '';
                    return;
                }
                const cards = getCards();
                if (!cards.length) return;
                const visible = getVisible();
                const max = Math.max(0, cards.length - visible);
                index = Math.min(Math.max(index, 0), max);
                const cardWidth = cards[0].offsetWidth + getGap();
                grid.style.transform = 'translateX(-' + (index * cardWidth) + 'px)';
                prevBtn.disabled = index === 0;
                nextBtn.disabled = index >= max;
            }

            prevBtn.addEventListener('click', function () { index--; update(); });
            nextBtn.addEventListener('click', function () { index++; update(); });
            window.addEventListener('resize', function () { index = 0; update(); });

            update();
        })();
    </script>
</body>
</html>
